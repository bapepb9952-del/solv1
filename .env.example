# Supabase > Settings > API (or `npx supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only scripts/seed.ts uses this secret. Never prefix it with NEXT_PUBLIC_.
# Use the local service_role key or your project's legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SEED_DEMO=false
DEMO_PASSWORD=choose-a-unique-demo-password-at-least-12-characters
